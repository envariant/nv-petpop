# Copy to .env and fill in. Never commit .env. Every variable PetPop reads is listed here.

# --- GenAI host (config/genai/<profile>.yaml holds every model, host default, timeout and quality setting)
GENAI_PROFILE=mock               # the default profile (kiosk bespoke jobs, jobs that name none): mock | tripo-manual | tripo | mac-m4pro | nvidia-24gb
PETPOP_STUDIO_PROFILES=          # more profiles Studio may pick per job, e.g. tripo-manual,tripo,mock (decision 113)
PETPOP_QUALITY=                  # quality preset inside the profile; empty = the profile's default
TEXTURE_BACKEND=                 # override the profile: projection (default everywhere) | flat | hy_paint (NVIDIA only)
COMFY_URL=                       # empty = profile default; mac-m4pro: https://<tunnel>/comfy
SHAPE_URL=                       # mac-m4pro only: https://<tunnel>/shape
OLLAMA_URL=                      # empty = profile default; mac-m4pro: https://<tunnel>/ollama
GENAI_TOKEN=                     # bearer token the Mac's proxy checks (mac/genai.env on the Mac); never commit
PETPOP_ADAPTERS=                 # bring-up override, e.g. shape=mock,texture=mock

# --- commercial GenAI APIs (docs/PROVIDERS.md; manual mode needs no key: docs/MANUAL-MODE.md)
TRIPO_API_KEY=                   # tsk_... from platform.tripo3d.ai (API credits, not Tripo Studio credits); never commit
TRIPO_API_URL=                   # empty = https://openapi.tripo3d.ai; the China endpoint or a test double otherwise
PETPOP_COMFY_RESTART_CMD=        # optional: command the worker runs when ComfyUI stops answering for 30 s

# --- mock pacing and fault injection
PETPOP_MOCK_SPEED=0.1            # fraction of each stage's reference seconds a mock stage sleeps; 0 = instant
PETPOP_FAIL_STAGE=               # A|B|C|D|E|F makes that stage fail (exercises the fallbacks)
PETPOP_VAR=./var                 # local state: SQLite DB, artefact store, fulfilment folder, logs

# --- secrets (generate: python -c "import secrets; print(secrets.token_hex(32))")
PETPOP_SECRET=                   # HMAC key for signed artefact URLs and result links
PETPOP_STAFF_TOKEN=              # kiosk five-tap ops panel PIN (LAN only)
PETPOP_STUDIO_PASSWORD=          # studio accounts operator/curator/admin share it (dev); or:
PETPOP_STUDIO_USERS=             # name:role:password;... (roles operator, curator, admin)
KIOSK_BESPOKE=0                  # 1 shows "Make it unique" on the kiosk (a studio job, "we'll message you")
PETPOP_RELEASE_KEY=              # signs and verifies library releases; unset = the dev key the proxy releases use
PETPOP_RELEASE_INBOX=            # where Studio drops release-<species>-<n>.tar (default var/releases/inbox)
PETPOP_SEED_PROXY_LIBRARY=1      # a fresh kiosk loads the committed proxy releases (fixtures/library/)

# --- API / kiosk
API_HOST=127.0.0.1
API_PORT=8000
PETPOP_PUBLIC_URL=               # origin used in QR result links, e.g. http://192.168.1.20:8000
KIOSK_ID=kiosk-1
PETPOP_FULFIL_DIR=./var/fulfilment   # folder the print station watches

# --- deployment role (decision 124, docs/DEPLOY.md)
PETPOP_DEPLOY=all                # all = one box | cloud = customer app + kiosks + exports | studio = Studio in the shop
PETPOP_CLOUD_URL=                # studio: the cloud API it syncs with, e.g. https://petpop.example.com
PETPOP_SYNC_TOKEN=               # cloud and studio: the same long random token on both (never committed)
PETPOP_SYNC_INTERVAL=15          # studio: seconds between sync rounds
PETPOP_TLS_DOMAIN=               # make up: Caddy terminates TLS for this name (Let's Encrypt); empty = no Caddy

# --- payment for orders (decision 125, docs/DEPLOY.md)
PETPOP_PAYMENTS=off              # off = pay at the counter | fake = test provider (simulate button) | hitpay
PETPOP_PRICE_SGD=39.00           # price of a figurine (placeholder: set yours)
HITPAY_API_URL=                  # empty = the sandbox (https://api.sandbox.hit-pay.com/v1); live: https://api.hit-pay.com/v1
HITPAY_API_KEY=                  # HitPay dashboard, API keys (never committed)
HITPAY_SALT=                     # the webhook's salt, from the dashboard (never committed)

# --- customer accounts and notifications (decision 126, docs/DEPLOY.md)
PETPOP_APPLE_CLIENT_IDS=         # Sign in with Apple audiences: iOS bundle id, then the web Services ID, comma separated
PETPOP_GOOGLE_CLIENT_IDS=        # Google OAuth client ids: the web one first, then iOS and Android
PETPOP_DEFAULT_COUNTRY_CODE=65   # phone numbers given without a country code
PETPOP_EMAIL=log                 # log = codes and messages in the log (development) | ses = Amazon SES (paid per message)
PETPOP_EMAIL_FROM=PetPop <hello@petpop.sg>   # ses: a verified sender
PETPOP_SMS=log                   # log | sns = Amazon SNS transactional SMS (paid per message)
PETPOP_SMS_SENDER_ID=            # sns: an alphanumeric sender id (Singapore: registered with SGNIC first)
PETPOP_PUSH=log                  # log | fcm = Firebase Cloud Messaging (free)
PETPOP_FCM_CREDENTIALS=          # fcm: path to the Firebase service account JSON (never committed)
PETPOP_AUTH_FAKE=0               # tests only: fake Apple/Google tokens; never on a real server

# --- storage and queue (make dev uses SQLite + a local folder + the local bus; make up sets these itself)
DATABASE_URL=                    # empty = sqlite in PETPOP_VAR; make up: empty = the Compose postgres, or RDS's URL
POSTGRES_PASSWORD=               # make up with the Compose postgres
REDIS_URL=                       # empty = local queue (make dev)
S3_ENDPOINT=                     # empty = local folder store (make dev) / the Compose MinIO (make up); aws = AWS S3
S3_BUCKET=petpop
S3_ACCESS_KEY=                   # MinIO root user; on AWS leave empty to use the EC2 instance role
S3_SECRET_KEY=                   # MinIO root password; on AWS leave empty
AWS_DEFAULT_REGION=              # S3_ENDPOINT=aws: the bucket's region, e.g. ap-southeast-1

# --- models and Blender
PETPOP_MODELS=/srv/models        # model root on a GenAI host (Mac: ~/petpop-models)
HF_TOKEN=                        # optional, for gated Hugging Face downloads by scripts/models.py
PETPOP_BPY_PYTHON=/opt/bpy/bin/python   # make dev: Python 3.11 with the bpy wheel; empty = trimesh stand-in
PETPOP_BUILD_CA=                 # optional extra CA for docker builds behind a TLS-inspecting proxy
PETPOP_PLATFORM=                 # make up: app image platform; empty = linux/amd64 (bpy has no Linux ARM wheel)
