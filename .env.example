# Copy to .env and fill in. Never commit .env. Every variable PetPop reads is listed here.

# --- mode
PETPOP_MODE=mock                 # mock (CPU, default) | real (GPU host)
PETPOP_MOCK_SPEED=0.1            # fraction of each real stage timeout a mock stage sleeps; 0 = instant
PETPOP_FAIL_STAGE=               # fault injection: A|B|C|D|E|F makes that stage fail (tests the fallbacks)
PETPOP_VAR=./var                 # local state: SQLite DB, artefact store, fulfilment folder, logs

# --- secrets (generate: python -c "import secrets; print(secrets.token_hex(32))")
PETPOP_SECRET=                   # HMAC key for signed artefact URLs and result links
PETPOP_STAFF_TOKEN=              # staff panel token (LAN only)

# --- API / kiosk
API_HOST=127.0.0.1
API_PORT=8000
PETPOP_PUBLIC_URL=               # origin used in QR result links, e.g. http://192.168.1.20:8000
KIOSK_ID=kiosk-1
PETPOP_FULFIL_DIR=./var/fulfilment   # folder the print station watches

# --- storage and queue (make up / GPU host)
DATABASE_URL=sqlite:///./var/petpop.db        # postgresql+psycopg://petpop:CHANGE_ME@postgres:5432/petpop on the GPU host
POSTGRES_PASSWORD=
REDIS_URL=                                    # redis://redis:6379/0 on the GPU host; empty = local queue
S3_ENDPOINT=                                  # http://minio:9000 on the GPU host; empty = local folder store
S3_BUCKET=petpop
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- GPU services (S3)
COMFY_URL=http://comfyui:8188
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
PETPOP_MODELS=/srv/models

# --- Blender
PETPOP_BPY_PYTHON=/opt/bpy/bin/python        # Python 3.11 with the bpy wheel; empty = trimesh stand-in
