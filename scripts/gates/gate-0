#!/usr/bin/env bash
# Gate 0 (S0/M0): contract and mock server.
source "$(dirname "$0")/lib.sh"
echo "gate-0: contract and mock server"
step "schemas, vocab, presets, parser, fixtures (unit)" env PETPOP_MOCK_SPEED=0 "$PY" -m pytest tests/unit
step "contract test against the mock server" env PETPOP_MOCK_SPEED=0 "$PY" -m pytest tests/contract -k "not backend"
step "mock scripts reach every kiosk state" "$PY" -m pytest mock-server/tests
step "openapi.json matches the contract router" "$PY" scripts/export_openapi.py --check
step "base meshes pass check_base_mesh" "$PY" scripts/check_base_mesh.py
step "TypeScript client generated from openapi.json" bash -c 'cd apps/kiosk && npx openapi-typescript ../../data/schema/openapi.json -o /tmp/pp-schema.d.ts >/dev/null && diff -q /tmp/pp-schema.d.ts src/api/schema.d.ts'
step "MSW handlers cover every path; client typechecks" bash -c 'cd apps/kiosk && npx vitest run && npx tsc -b --noEmit'
step "mock server boots and answers" bash -c '
  "$0" -m mock_server --port 8765 & pid=$!
  trap "kill $pid" EXIT
  for i in $(seq 1 30); do curl -fsS http://127.0.0.1:8765/api/v1/health && exit 0; sleep 0.5; done; exit 1' "$PY"
echo "GATE 0 PASSED"
