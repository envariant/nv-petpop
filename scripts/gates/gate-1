#!/usr/bin/env bash
# Gate 1 (S1/M1): both front ends (customer app and studio, BRIEF Section 17) against the mock server. The Playwright
# walkthroughs are the gate; the per-screen tests, stories and builds must also be green.
source "$(dirname "$0")/lib.sh"
echo "gate-1: front end in full"
step "web unit tests (MSW coverage, screen coverage, stamp rasteriser) and typecheck, scene and both apps" bash -c '(cd packages/scene && npx vitest run && npx tsc -p . --noEmit) && for a in customer studio; do (cd apps/$a && npx vitest run && npm run -s typecheck) || exit 1; done'
step "openapi.json and the TypeScript client match the contract router" bash -c '"$0" scripts/export_openapi.py --check && npx openapi-typescript data/schema/openapi.json -o /tmp/pp-schema.d.ts >/dev/null && diff -q /tmp/pp-schema.d.ts packages/core/src/api/schema.d.ts' "$PY"
step "packages never import apps or the backend" bash -c '! grep -rnE "^import .*(/apps/|@petpop/(kiosk|studio))" packages/*/src && ! grep -rnE "^(from|import) (backend|mock_server)" packages/*/python'
step "production SPA builds (customer, studio)" bash -c 'for a in customer studio; do (cd apps/$a && npm run -s build) || exit 1; done'
step "Storybook builds (a story per screen, three directions), both apps" bash -c 'for a in customer studio; do (cd apps/$a && npm run -s build-storybook) || exit 1; done'
step "Playwright: per-screen tests (customer: kiosk, phone, tablet, desktop)" bash -c 'cd apps/customer && npx playwright test tests/e2e/screens.spec.ts'
step "Playwright: per-screen tests (studio)" bash -c 'cd apps/studio && npx playwright test tests/e2e/screens.spec.ts'
step "Playwright: touch walkthrough (gate-1, customer: kiosk, phone, tablet, desktop)" bash -c 'cd apps/customer && npx playwright test tests/e2e/walkthrough.spec.ts'
step "native bundle (Capacitor): showcase assets only, under budget, the walkthrough runs on it" bash -c 'cd apps/customer && npm run -s bundle:native && PP_NATIVE=1 npx playwright test --project=phone tests/e2e/walkthrough.spec.ts'
step "Playwright: touch walkthrough (gate-1, studio)" bash -c 'cd apps/studio && npx playwright test tests/e2e/walkthrough.spec.ts'
echo "GATE 1 PASSED"
