#!/usr/bin/env bash
# Gate 3: concept and four views (stages B, C) from the GenAI host.
# Runs against the GenAI host named by GENAI_PROFILE (config/genai/<profile>.yaml); skipped on the mock profile.
source "$(dirname "$0")/lib.sh"
skip_without_genai_host 3
echo "gate-3: concept and four views (stages B, C) from the GenAI host (GenAI profile $GENAI_PROFILE)"
step "GenAI services reachable" "$PY" scripts/genai_check.py
step "contract test against the backend on this profile" env PETPOP_QUALITY="${PETPOP_QUALITY:-test}" "$PY" -m pytest tests/contract -k backend
step "regression set meets the gate-3 thresholds of this profile" "$PY" scripts/regress.py --gate 3
echo "GATE 3 PASSED"
