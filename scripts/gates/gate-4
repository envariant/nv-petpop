#!/usr/bin/env bash
# Gate 4: shape (stage D) with the silhouette IoU gate.
# Runs against the GenAI host named by GENAI_PROFILE (config/genai/<profile>.yaml); skipped on the mock profile.
source "$(dirname "$0")/lib.sh"
skip_without_genai_host 4
echo "gate-4: shape (stage D) with the silhouette IoU gate (GenAI profile $GENAI_PROFILE)"
step "GenAI services reachable" "$PY" scripts/genai_check.py
step "contract test against the backend on this profile" env PETPOP_QUALITY="${PETPOP_QUALITY:-test}" "$PY" -m pytest tests/contract -k backend
step "regression set meets the gate-4 thresholds of this profile" "$PY" scripts/regress.py --gate 4 ${PETPOP_REGRESS_LIMIT:+--limit "$PETPOP_REGRESS_LIMIT"}
echo "GATE 4 PASSED"
