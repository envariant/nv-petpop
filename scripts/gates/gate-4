#!/usr/bin/env bash
# Gate 4 (S3): Hunyuan3D shape (stage D) with the IoU gate. Runs only on the GPU host (PETPOP_MODE=real).
source "$(dirname "$0")/lib.sh"
skip_without_gpu 4
echo "gate-4: Hunyuan3D shape (stage D) with the IoU gate"
step "GPU services reachable" bash -c 'curl -fsS "${COMFY_URL:?COMFY_URL}/system_stats" && curl -fsS "${OLLAMA_URL:?OLLAMA_URL}/api/tags"'
step "contract test against the real backend (real adapters)" env PETPOP_GATE=4 "$PY" -m pytest tests/contract -k backend
step "regression metrics meet gate 4 thresholds" "$PY" scripts/regress.py --gate 4
echo "GATE 4 PASSED"
