{
  "name": "@petpop/studio",
  "private": true,
  "version": "0.1.0",
  "description": "PetPop Studio: the staff app (generate, curate, publish; BRIEF Section 17), Vue 3, desktop first (decision 122)",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "vite",
    "dev:mock": "npm run sync-assets && VITE_MOCK=1 vite",
    "prebuild": "npm run sync-assets",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@petpop/core": "0.2.0",
    "@petpop/scene": "0.3.0",
    "@petpop/ui-vue": "0.1.0",
    "openapi-fetch": "^0.13.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "three": "^0.169.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/vue3": "8.6.19",
    "@storybook/vue3-vite": "8.6.19",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "msw": "^2.6.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.47",
    "storybook": "^8.4.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0",
    "vue-tsc": "^3.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
