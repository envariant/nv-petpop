{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@data/*": ["../../data/*"], "@fixtures/*": ["../../fixtures/*"], "@mockscripts/*": ["../../mock-server/scripts/*"], "@assets/*": ["../../assets/*"] }
  },
  "include": ["src", ".storybook", "tests", "vite.config.ts", "playwright.config.ts"]
}
