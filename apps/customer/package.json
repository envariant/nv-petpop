{
  "name": "@petpop/customer",
  "private": true,
  "version": "0.1.0",
  "description": "PetPop customer app (Vue 3, decision 122): library mode on phones, tablets, desktops and kiosks; packaged for the app stores with Capacitor.",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "vite",
    "dev:mock": "npm run sync-assets && VITE_MOCK=1 vite",
    "prebuild": "npm run sync-assets",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:native": "npm run build && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@petpop/core": "0.2.0",
    "@petpop/scene": "0.3.0",
    "@petpop/ui": "0.2.0",
    "@petpop/ui-vue": "0.1.0",
    "openapi-fetch": "^0.13.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "three": "^0.169.0",
    "vue": "^3.5.13",
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "msw": "^2.6.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0",
    "vue-tsc": "^3.0.0",
    "@capacitor/cli": "8.5.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
