{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petpop.local/schema/genai-profile.schema.json",
  "title": "GenAIProfile",
  "description": "config/genai/<profile>.yaml: every endpoint, model id, quality setting, residency rule, timeout and expected timing for one GenAI host. The worker reads these; it never names a model or host itself.",
  "type": "object",
  "required": ["profile", "version", "description", "host", "mode", "quality", "timeouts_s", "expected_s", "latency", "residency", "services", "parser", "image", "shape", "texture", "gates"],
  "properties": {
    "profile": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "host": {"type": "object", "required": ["kind", "accelerator"], "properties": {"kind": {"enum": ["cpu", "apple-silicon", "nvidia", "api"]}, "accelerator": {"enum": ["none", "mps", "cuda"]}, "memory_gb": {"type": ["number", "null"]}}},
    "mode": {"enum": ["mock", "real"]},
    "quality": {
      "type": "object", "required": ["default", "presets"],
      "properties": {
        "default": {"type": "string"},
        "presets": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/quality"}}
      }
    },
    "timeouts_s": {"$ref": "#/$defs/stage_seconds"},
    "pacing_reference_s": {"$ref": "#/$defs/stage_seconds"},
    "expected_s": {
      "type": "object", "required": ["A", "control", "B", "C", "D", "E", "F", "total"],
      "properties": {"total": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
      "additionalProperties": {"type": "number"}
    },
    "latency": {"type": "object", "required": ["target_s", "enforce"], "properties": {"target_s": {"type": ["number", "null"]}, "enforce": {"type": "boolean"}}},
    "residency": {
      "type": "object",
      "properties": {
        "max_resident_models": {"type": ["integer", "null"]},
        "free_comfy_after_call": {"type": "boolean"},
        "free_comfy_before": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
        "ollama_keep_alive_s": {"type": ["integer", "null"]},
        "shape_unload_after_call": {"type": "boolean"}
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "auth_token_env": {"type": "string"},
        "comfy_args": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": {
        "anyOf": [
          {"type": "object", "required": ["env", "default"], "properties": {"env": {"type": "string", "pattern": "^[A-Z_]+$"}, "default": {"type": "string"}}},
          {"type": "string"}, {"type": "array"}
        ]
      }
    },
    "parser": {"type": "object", "required": ["backend", "timeout_s"], "properties": {"backend": {"enum": ["rules", "ollama"]}, "service": {"type": "string"}, "model": {"type": "string"}}},
    "image": {"type": "object", "required": ["backend", "matting"], "properties": {"backend": {"enum": ["mock", "comfy", "api"]}, "provider": {"type": "string"}, "views": {"enum": ["none", "provider", "workflow"]}, "service": {"type": "string"}, "workflows": {"type": "object"}, "models": {"type": "object"}, "params": {"type": "object"}, "matting": {"type": "object", "required": ["method"], "properties": {"method": {"enum": ["alpha", "white_key", "birefnet", "border_key"]}}}}},
    "shape": {"type": "object", "required": ["backend", "views", "iou_min", "height_mm"], "properties": {"backend": {"enum": ["mock", "comfy", "http", "api"]}, "provider": {"type": "string"}, "views": {"type": "array", "items": {"enum": ["front", "left", "back", "right"]}, "minItems": 1}, "iou_min": {"type": "number"}}},
    "paths": {
      "type": "object", "description": "Library quality by default; job kinds (paths.by_kind) can take a faster path.",
      "properties": {"default": {"type": "string"}, "by_kind": {"type": "object", "additionalProperties": {"type": "string"}}},
      "additionalProperties": {"type": ["object", "string"], "properties": {"shape": {"enum": ["multiview", "single_view"]}}}
    },
    "texture": {"type": "object", "required": ["backend", "allowed"], "properties": {"backend": {"enum": ["projection", "flat", "hy_paint", "transfer"]}, "allowed": {"type": "array", "items": {"enum": ["projection", "flat", "hy_paint", "transfer"]}}}},
    "providers": {
      "type": "object", "description": "Commercial GenAI APIs (decision 108): base URL (url, or url_env to override), the environment variable holding the key, and the provider class (kind).",
      "additionalProperties": {"type": "object", "required": ["kind", "url", "key_env"], "properties": {"kind": {"type": "string"}, "manifest": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "url": {"type": "string"}, "url_env": {"type": "string", "pattern": "^[A-Z_]+$"}, "key_env": {"type": "string", "pattern": "^[A-Z_]+$"}}}
    },
    "gates": {"type": "object", "required": ["iou_min", "p50_s", "max_s"]}
  },
  "$defs": {
    "stage": {"enum": ["A", "control", "B", "C", "D", "E", "F"]},
    "stage_seconds": {"type": "object", "required": ["A", "control", "B", "C", "D", "E", "F"], "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "quality": {
      "type": "object",
      "required": ["concept_px", "view_px", "control_px", "samples", "albedo_px", "voxel_mm", "print_tris", "turntable_frames", "turntable_px", "mask_px"],
      "additionalProperties": {"type": "number"}
    }
  }
}
