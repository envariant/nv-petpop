<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PetPop shape server (Hunyuan3D-2.1 on the MPS fork) for the mac-m4pro GenAI profile. Rendered by mac/setup.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.petpop.shape</string>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__GENAI__/venvs/shape/bin/python</string>
    <string>__REPO__/mac/shape_server/server.py</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8190</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GENAI_PROFILE</key><string>mac-m4pro</string>
    <key>HY3D_DIR</key><string>__GENAI__/hunyuan3d-2.1-mac</string>
    <key>PETPOP_MODELS</key><string>__MODELS__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__GENAI__/logs/shape.log</string>
  <key>StandardErrorPath</key><string>__GENAI__/logs/shape.log</string>
</dict>
</plist>
